{
  "name": "tribunal-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Tribunal — a glass-box due-process layer for high-stakes AI decisions.",
  "author": "Pablo Zavala (Carnegie Mellon University)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "demo": "tsx packages/kernel/scripts/demo.ts",
    "demo:real": "tsx packages/kernel/scripts/real_smoke.ts",
    "experiment:clinical:simulate": "npm run simulate --workspace @tribunal/clinical-eval --",
    "experiment:clinical:analyze": "npm run analyze --workspace @tribunal/clinical-eval --",
    "experiment:clinical:verify": "npm run verify --workspace @tribunal/clinical-eval --",
    "record:demo": "node scripts/record_demo.mjs",
    "submit:prep": "node scripts/submit_prep.mjs",
    "build:web": "npm run build --workspace @tribunal/web",
    "server": "npm run dev --workspace @tribunal/server",
    "web": "npm run dev --workspace @tribunal/web"
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
