# Tribunal environment (copy to .env and fill in as needed).
# Keys are read at call time; nothing is stored by Tribunal itself.

# OpenRouter — one key enables the five-vendor panel (Microsoft, NVIDIA, Meta, DeepSeek, Mistral).
# Required only for `mode: "openrouter"` runs or `npm run demo:real` with OpenRouter.
OPENROUTER_API_KEY=

# API server port (default 8787).
PORT=8787

# API bind address (default 127.0.0.1). Keep this loopback-only unless remote
# access is intentional and protected; any non-loopback value requires the
# operator token below before the server will start.
HOST=127.0.0.1

# Directory where finished runs are persisted (default: runs/ at repo root).
TRIBUNAL_RUNS_DIR=runs

# Per-provider-call deadline at the decoder service edge, in milliseconds
# (default 1800000 = 30 minutes). The kernel and direct CLI adapter default to
# no deadline; a service timeout fails the run closed and never fabricates STOP.
TRIBUNAL_DECODER_TIMEOUT_MS=1800000

# Required explicitly whenever HOST is not loopback. On loopback, omission makes
# the server generate and print a process-local random token that rotates on each
# restart. Generate a high-entropy, unique token for stable use; pass it at
# runtime, never commit it, and rotate it if exposed.
# Direct API clients use it as a Bearer token. Browser unlock sends it once in
# Authorization and receives an opaque HttpOnly session scoped to /api. The gate
# covers quota-bearing, mutating, intervention, decoder, and ledger routes even
# on loopback. Never put the token in web storage, a URL, or bundled client
# configuration. Minimum 32 bytes; use trusted transport.
TRIBUNAL_OPERATOR_TOKEN=

# Legacy alias accepted for compatibility. If both names are set, they must be
# identical. Prefer TRIBUNAL_OPERATOR_TOKEN for new deployments.
TRIBUNAL_DECODER_OPERATOR_TOKEN=

# Exact comma-separated Host headers accepted by the API in addition to the
# loopback defaults for PORT. Required for a reverse-proxy/public hostname; no
# wildcards, schemes, paths, or DNS suffix matching.
TRIBUNAL_ALLOWED_HOSTS=

# Optional comma-separated exact browser origins for whole-service CORS, with no
# paths or trailing slash. Loopback API/Vite origins are allowed by default;
# configure the public HTTPS origin when using a trusted reverse proxy.
TRIBUNAL_ALLOWED_ORIGINS=

# Legacy origin alias; values are merged into the same exact allowlist.
TRIBUNAL_DECODER_ALLOWED_ORIGINS=

# Trust X-Forwarded-Proto=https for decoder unlock and Secure cookies only when
# an authenticated TLS proxy overwrites that header and the backend listener is
# unreachable directly. Leaving this false rejects spoofed HTTPS Origin headers.
TRIBUNAL_DECODER_TRUST_PROXY=false

# Anthropic CLI model alias — pinned explicitly (operator requirement: sonnet or opus, never fable).
# Used by the `claude` CLI adapter when mode is `cli`.
TRIBUNAL_CLAUDE_MODEL=sonnet

# Optional Cursor agent model override for the `cursor-agent` CLI seat.
# Requires `cursor-agent login` or CURSOR_API_KEY in the environment.
TRIBUNAL_CURSOR_MODEL=
