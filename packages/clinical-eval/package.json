{
  "name": "@tribunal/clinical-eval",
  "version": "0.1.0",
  "description": "Reproducible evaluation harness for Tribunal Clinical escalation, agreement, and evidence-versus-conformity experiments.",
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "simulate": "tsx scripts/run-mechanism-simulation.ts",
    "analyze": "tsx scripts/analyze-observations.ts",
    "receipt-external": "tsx scripts/receipt-external-observations.ts",
    "verify": "tsx scripts/verify-run.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
